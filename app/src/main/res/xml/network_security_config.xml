<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext is allowed for loopback only.

  The gateway and the tool bridge both speak plain HTTP on 127.0.0.1, which is
  correct: TLS on a loopback socket buys nothing and costs a handshake per tool call.
  Every other host must be HTTPS, and user-added CAs are trusted only in debug builds
  so that a proxy cannot silently read provider traffic on a release build.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>

    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
